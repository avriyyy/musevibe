# Supabase Auth (project URL and public anon/publishable key only)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-here
# Canonical public origin for confirmation and password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon workspace database; use ONE server-only pooled connection string, never NEXT_PUBLIC_.
# Vercel's Neon integration may provide POSTGRES_URL or STORAGE_DATABASE_URL instead.
DATABASE_URL=
# POSTGRES_URL=
# STORAGE_DATABASE_URL=

# AI - Muse models (Meta). Keep AI_API_KEY server-only; leave empty to run the local fallbacks.
AI_API_URL=
AI_API_KEY=
AI_MODEL=muse-spark-1.3
AI_IMAGE_MODEL=muse-image-1.0
AI_VOICE_MODEL=muse-voice-transcribe-1.0
