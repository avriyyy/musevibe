# Supabase Auth ONLY (isi dari dashboard Supabase). Supabase TIDAK lagi
# dipakai sebagai database: data project ada di Neon (lihat neon/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-here

# Neon Postgres (dari integrasi Neon di Vercel, atau dashboard Neon).
# Dipakai server-side saja oleh /api/sync; jangan pakai prefix NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI - Muse models (Meta). Leave empty to run the local fallbacks.
AI_API_URL=
AI_API_KEY=
AI_MODEL=muse-spark-1.3
AI_IMAGE_MODEL=muse-image-1.0
AI_VOICE_MODEL=muse-voice-transcribe-1.0
